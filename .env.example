# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Restoration store
RESTORATION_TTL_SECONDS=3600
RESTORATION_MAX_ENTRIES=1000000
# "memory" for single worker, "redis" for multiple workers
RESTORATION_STORE_BACKEND=memory
# Redis connection. For auth use a URL with credentials, e.g.
# redis://:password@redis-host:6379/0, or set REDIS_PASSWORD separately.
REDIS_URL=redis://localhost:6379/0

# Redis password (required when using docker-compose). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be identical across all workers and never committed.
REDIS_PASSWORD=

# Fernet key for encrypting restoration state at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED when RESTORATION_STORE_BACKEND=redis (the service fails fast if unset).
# Must be identical across all workers.
MASKING_KEY=

# Consumers
CONSUMERS_DIR=configs/consumers
DEFAULT_CONSUMER_ID=default

# Server
HOST=0.0.0.0
PORT=8000

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=1.0