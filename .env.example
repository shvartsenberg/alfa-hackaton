# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Restoration store
RESTORATION_TTL_SECONDS=3600
RESTORATION_MAX_ENTRIES=1000000
# "memory" for single worker, "redis" for multiple workers
RESTORATION_STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Fernet key for encrypting restoration state at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a random key is generated at startup (state is not recoverable across restarts).
MASKING_KEY=

# Consumers
CONSUMERS_DIR=configs/consumers
DEFAULT_CONSUMER_ID=default

# Server
HOST=0.0.0.0
PORT=8000

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=1.0